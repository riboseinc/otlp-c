---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
---
<Base title="Not found — otlp-c">
  <section class="flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <div class="font-mono text-7xl font-bold text-teal-400/60">404</div>
    <h1 class="mt-4 text-2xl font-semibold text-slate-100">Nothing on the wire here</h1>
    <p class="mt-2 text-slate-400">The page you asked for was dropped — but unlike a dropped span, it won't be retried.</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="rounded-lg bg-teal-500 px-5 py-2.5 text-sm font-semibold text-ink-950 transition hover:bg-teal-400">Home</a>
      <a href="/docs/" class="rounded-lg border border-ink-700 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-teal-500/50">Docs</a>
    </div>
  </section>
</Base>

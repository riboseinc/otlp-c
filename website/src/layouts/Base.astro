---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "otlp-c — pure-C OpenTelemetry",
  description = "A pure-C99 OTLP/HTTP client library. All three signals — traces, metrics, logs — with zero non-libc dependencies.",
} = Astro.props;
const nav = [
  { href: "/about/", label: "About" },
  { href: "/audiences/", label: "Audiences" },
  { href: "/use-cases/", label: "Use cases" },
  { href: "/docs/", label: "Docs" },
  { href: "/examples/", label: "Examples" },
  { href: "/api/", label: "API" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="font-sans antialiased">
    <header class="sticky top-0 z-40 border-b border-ink-700/60 bg-ink-950/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
        <a href="/" class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-500/15 font-mono text-sm font-bold text-teal-300">o</span>
          <span class="font-mono text-lg font-semibold tracking-tight text-slate-100">otlp-c</span>
          <span class="hidden rounded-full border border-teal-500/30 bg-teal-500/10 px-2 py-0.5 font-mono text-[10px] text-teal-300 sm:inline">v1.0 · API frozen</span>
        </a>
        <nav class="hidden items-center gap-6 md:flex">
          {nav.map((item) => (
            <a href={item.href} class="text-sm text-slate-400 transition hover:text-teal-300">{item.label}</a>
          ))}
        </nav>
        <a href="https://github.com/riboseinc/otlp-c" class="rounded-lg border border-ink-700 px-3 py-1.5 font-mono text-xs text-slate-300 transition hover:border-teal-500/50 hover:text-teal-300">
          GitHub
        </a>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-6">
      <slot />
    </main>
    <footer class="mt-24 border-t border-ink-700/60">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <span class="font-mono text-slate-300">otlp-c</span> — pure-C OTLP/HTTP client.
          BSD 3-Clause. A <a href="https://www.ribose.com" class="underline decoration-ink-700 hover:text-teal-300">Ribose</a> project.
        </div>
        <div class="flex gap-5">
          <a href="https://github.com/riboseinc/otlp-c" class="hover:text-teal-300">Source</a>
          <a href="/api/" class="hover:text-teal-300">API reference</a>
          <a href="https://github.com/riboseinc/otlp-c/blob/main/CHANGELOG.md" class="hover:text-teal-300">Changelog</a>
        </div>
      </div>
    </footer>
  </body>
</html>
